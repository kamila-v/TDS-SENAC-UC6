<?xml version="1.0" encoding="utf-8" ?>

<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    x:Class="EstoqueMAUI.MainPage" 
    Title="Cadastro de Produtos"
    Background="#111427">

    <ScrollView>
        <VerticalStackLayout 
            Padding="25" 
            Spacing="18">

            <Label 
                Text="CONTROLE DE ESTOQUE"
                TextColor="#FFFFFF"
                FontSize="26" 
                FontAttributes="Bold" 
                HorizontalOptions="Center"/>

            <Label 
                Text="Cadastro de produtos" 
                TextColor="#FFFFFF"
                FontSize="18" 
                HorizontalOptions="Center"/>

            <Entry 
                x:Name="NomeEntry" 
                PlaceholderColor="#FFFFFF" Placeholder="Nome do produto"
                TextColor="#FFFFFF"
                BackgroundColor="#80FFFFFF"/>

            <Entry 
                x:Name="QuantidadeEntry"
                PlaceholderColor="#FFFFFF" Placeholder="Quantidade" 
                TextColor="#FFFFFF"
                Keyboard="Numeric"
                BackgroundColor="#80FFFFFF"/>

            <Button 
                Text="Cadastrar produto" 
                Clicked="OnAdicionarClicked" 
                BackgroundColor="#ECA72C" 
                TextColor="#FFFFFF"/>

            <Label 
                x:Name="ResultadoLabel" 
                Text="Preencha os dados do produto." 
                TextColor="#FFFFFF"
                FontSize="16" 
                HorizontalOptions="Center"/>

        </VerticalStackLayout>

    </ScrollView>
    
</ContentPage>
